{
  "name": "smartcard",
  "version": "3.7.2",
  "description": "PC/SC bindings for Node.js using N-API - ABI stable across Node.js versions",
  "keywords": [
    "acr122",
    "card-reader",
    "contactless",
    "napi",
    "nfc",
    "node-addon-api",
    "pcsc",
    "pcsclite",
    "rfid",
    "smart-card",
    "smartcard"
  ],
  "homepage": "https://github.com/tomkp/smartcard#readme",
  "bugs": {
    "url": "https://github.com/tomkp/smartcard/issues"
  },
  "license": "MIT",
  "author": "Tom KP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomkp/smartcard.git"
  },
  "files": [
    "lib/",
    "src/",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "test": "node --test 'test/*.test.js'",
    "test:coverage": "c8 --include=lib/**/*.js --reporter=text --reporter=html node --test 'test/*.test.js'",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "c8": "^10.1.3",
    "node-gyp": "^12.2.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "gypfile": true
}
