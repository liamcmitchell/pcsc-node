{
  "name": "pcsc-node",
  "version": "1.0.0",
  "description": "PC/SC bindings for Node.js",
  "keywords": [
    "acr122",
    "card-reader",
    "contactless",
    "napi",
    "nfc",
    "node-addon-api",
    "pcsc",
    "pcsclite",
    "rfid",
    "smart-card",
    "smartcard"
  ],
  "homepage": "https://github.com/liamcmitchell/pcsc-node#readme",
  "bugs": {
    "url": "https://github.com/liamcmitchell/pcsc-node/issues"
  },
  "license": "MIT",
  "author": "Tom KP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamcmitchell/pcsc-node.git"
  },
  "files": [
    "lib/",
    "src/",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "c8 --include=lib/**/*.js --reporter=text --reporter=html node --test \"test/*.test.js\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "fmt:cpp": "clang-format -i -style=file src/addon.cpp src/pcsc_context.cpp src/pcsc_context.h src/pcsc_debug.h src/pcsc_errors.h src/pcsc_reader.cpp src/pcsc_reader.h"
  },
  "dependencies": {
    "node-addon-api": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "c8": "^11.0.0",
    "clang-format-node": "^3.0.1",
    "node-gyp": "^12.2.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^6.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "gypfile": true
}
