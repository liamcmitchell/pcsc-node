{
  "name": "smartcard",
  "version": "3.7.2",
  "description": "PC/SC bindings for Node.js using N-API - ABI stable across Node.js versions",
  "author": "Tom KP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomkp/smartcard.git"
  },
  "bugs": {
    "url": "https://github.com/tomkp/smartcard/issues"
  },
  "homepage": "https://github.com/tomkp/smartcard#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": "./lib/index.js",
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "test": "node --test test/unit/index.js",
    "test:unit": "node --test test/unit/index.js",
    "test:integration": "node --test test/integration/index.js",
    "test:coverage": "c8 --include=lib/**/*.js node --test test/unit/index.js",
    "typecheck": "tsc --noEmit",
    "coverage:report": "c8 report --reporter=text --reporter=html",
    "lint": "oxlint lib test examples",
    "lint:fix": "oxlint --fix lib test examples",
    "fmt": "oxfmt --write lib test examples",
    "fmt:check": "oxfmt --check lib test examples"
  },
  "files": [
    "lib/",
    "src/",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "c8": "^10.1.3",
    "node-gyp": "^10.0.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "pcsc",
    "pcsclite",
    "smartcard",
    "smart-card",
    "nfc",
    "rfid",
    "contactless",
    "napi",
    "node-addon-api",
    "acr122",
    "card-reader"
  ]
}
